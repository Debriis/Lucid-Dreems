extends Node
var failures := 0
var checks := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(message)
func wait(seconds: float = 0.4) -> void:
	await get_tree().create_timer(seconds).timeout
func _ready() -> void:
	await get_tree().process_frame
	Game.play_menu_music()
	check(Game.score.playing and not Game.music.playing, "Title uses supplied track")
	check(Game.score.stream.loop_offset == 2.0, "Loop overlap is respected")
	Game.score.seek(Game.score.stream.get_length() - 0.15)
	await wait()
	check(Game.score.get_playback_position() >= 2.0 and Game.score.get_playback_position() < 3.0, "Track wraps correctly")
	Game.play_music_box(false)
	await wait()
	check(not Game.score.playing and Game.music.playing, "Ordinary exploration restores original track")
	check(Game.music.stream.resource_path == Game.MUSIC_SPOOKY, "Cabin uses original waltz")
	Game.play_music_box(true)
	check(Game.music.stream.resource_path == Game.MUSIC_SAD, "Later rooms use original sad tune")
	Game.play_dialogue("PATIENT: You heard me.")
	Game.set_audio_paused(true)
	var held: float = Game.voice.get_playback_position()
	await wait()
	check(Game.score.playing and not Game.score.stream_paused and Game.score_context == "pause", "Pause music keeps playing")
	check(Game.music.stream_paused and Game.voice.stream_paused and absf(Game.voice.get_playback_position() - held) < 0.08, "World audio stays paused")
	var moving: float = Game.score.get_playback_position()
	await wait()
	check(Game.score.get_playback_position() > moving, "Pause track advances while world is frozen")
	Game.set_audio_paused(false)
	Game.stop_voice()
	await wait()
	check(not Game.score.playing and not Game.music.stream_paused, "Resume returns to prior music")
	Game.set_chase_music(true)
	await wait(0.7)
	check(Game.score.playing and Game.score_context == "chase" and Game.music.volume_db < -55.0, "Chase replaces background melody")
	Game.play_dialogue("DOCTOR: What happens when you close your eyes?")
	await wait()
	check(Game.score.volume_db <= -17.0, "Chase track yields to voice")
	Game.stop_voice()
	Game.play_scare("catch")
	check(Game.score.volume_db <= -26.0, "Chase track yields immediately to scare")
	Game.set_audio_paused(true)
	await wait()
	check(Game.score_context == "pause" and Game.score.playing, "Pausing a chase keeps menu track")
	Game.set_audio_paused(false)
	await wait()
	check(Game.score_context == "chase", "Resuming pursuit retains chase music")
	Game.set_chase_music(false)
	await wait(0.7)
	check(not Game.score.playing and Game.music.volume_db > -30.0, "Escaping restores original music")
	Game.unwind_music(1)
	await wait(0.2)
	check(Game.music.playing and Game._unwinding and not Game.score.playing, "Normal unwinding has no chase song")
	await wait(2.0)
	Game.unwind_music(4)
	await wait(2.3)
	check(not Game.score.playing and not Game.music.playing, "Fourth box falls silent")
	Game.set_chase_music(true)
	await wait()
	check(Game.score.playing, "Final pursuit can use chase track after last box")
	Game.silence()
	await wait()
	check(not Game.score.playing, "Ending stops pursuit track")
	Game.set_audio_paused(true)
	await wait()
	check(Game.score.playing, "Pause still has music after final silence")
	Game.set_audio_paused(false)
	await wait()
	check(not Game.score.playing, "Closing final pause restores silence")
	print("MUSIC CONTEXT RESULT: %d checks, %d failures" % [checks, failures])
	Game.request_quit(0 if failures == 0 else 1)